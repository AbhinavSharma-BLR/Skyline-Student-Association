# =============================================================================
# Skyline Student Association ERP — Environment Variable Template
# =============================================================================
# WARNING: Do NOT put real secrets in this file. Copy to .env.local for local development.
# =============================================================================

# PostgreSQL database connection URL (Used by Prisma ORM)
DATABASE_URL="postgresql://username:password@localhost:5432/skyline_dev?schema=public"

# Base URL of the application for Better Auth callbacks and redirects
BETTER_AUTH_URL="http://localhost:3000"

# Secret key used by Better Auth for signing tokens and session cookies (min 32 chars)
BETTER_AUTH_SECRET="replace-with-a-random-32-character-secret-in-local-env"

# Base URL exposed to browser clients for API calls and relative links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local filesystem storage path for uploaded receipts (outside public/ directory)
UPLOAD_DIR="./uploads"

# 32-byte secret key used to encrypt receipt access tokens and QR check-in tokens
RECEIPT_TOKEN_ENCRYPTION_KEY="replace-with-32-char-encryption-key-for-qr-tokens"

# Secret token required in x-job-runner-secret header for background job runner
JOB_RUNNER_SECRET="replace-with-secret-used-by-scheduled-cron-runner"

# Payment gateway mode ('demo' enables zero-cost simulation, 'live' requires real gateway)
PAYMENT_MODE="demo"

# Mock or live payment provider API key (server-only)
PAYMENT_PROVIDER_KEY="demo_payment_key_placeholder"

# Webhook secret used to verify payment confirmation webhook signatures
PAYMENT_WEBHOOK_SECRET="demo_webhook_signing_secret_placeholder"

# Mock or live transactional email provider API key (server-only)
EMAIL_API_KEY="demo_email_api_key_placeholder"

# Test-only rate-limit bypass flag (STRICTLY ignored unless NODE_ENV="test")
TEST_DISABLE_RATE_LIMIT="false"

# Local demonstration authorization flag (enables 1-click Quick Demo Access cards on /login)
ENABLE_LOCAL_DEMO="false"

# Local demo account credentials (used by seed script & demo cards; ignored outside local demo)
DEMO_GUEST_EMAIL="guest@skyline.edu"
DEMO_GUEST_PASSWORD="your-local-demo-guest-password"
DEMO_STUDENT_EMAIL="student@skyline.edu"
DEMO_STUDENT_PASSWORD="your-local-demo-student-password"
DEMO_OFFICER_EMAIL="officer@skyline.edu"
DEMO_OFFICER_PASSWORD="your-local-demo-officer-password"
DEMO_TREASURER_EMAIL="treasurer@skyline.edu"
DEMO_TREASURER_PASSWORD="your-local-demo-treasurer-password"

# Administrative account provisioning flag (enables staff role creation with invitation code on /signup)
ENABLE_ADMIN_SIGNUP_PROVISIONING="false"

# Role-specific invitation codes for staff account registration (server-only; NEVER expose to client)
ADMIN_INVITE_CODE_OFFICER="placeholder-officer-invitation-code"
ADMIN_INVITE_CODE_TREASURER="placeholder-treasurer-invitation-code"
